# Inherit CLAUDE_CONFIG_DIR (personal account) from ../../.envrc
source_up_if_exists

# Optional project-specific Anthropic API key (Console pay-per-token billing).
# Not required for account separation -- CLAUDE_CONFIG_DIR already carries the
# OAuth login. Stored in the macOS Keychain so the raw key never lands here:
#   security add-generic-password -s anthropic-airesume -a "$USER" -W
#
# Only exported when actually present: an empty ANTHROPIC_API_KEY would still
# take precedence over the OAuth login and break auth.
_ak="$(security find-generic-password -s anthropic-airesume -a "$USER" -w 2>/dev/null)"
[ -n "$_ak" ] && export ANTHROPIC_API_KEY="$_ak"
unset _ak
