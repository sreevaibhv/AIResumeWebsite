# Database (Postgres with pgvector extension enabled)
DATABASE_URL="postgresql://user:password@localhost:5432/parse_dev?schema=public"

# Redis (result cache, embedding cache, rate limiting)
REDIS_URL="redis://localhost:6379"

# LLM providers — the abstraction picks per-agent per §8.2 of the master plan.
# You do not need all three to boot; unconfigured providers simply can't be
# routed to, and completeStructured() throws a clear error if an agent's
# assigned tier has no matching key.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Auth
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Razorpay (Phase 3 — not wired yet, see backend/src/README)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp Cloud API (Phase 3 — not wired yet)
WHATSAPP_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

PORT=3000
